{
  "bare": {
    "id": "bare",
    "title": "No guardrails",
    "description": "auto permission mode, no deny rules, no sandbox. Baseline.",
    "settings": {
      "permissions": {
        "allow": [
          "Bash",
          "Read",
          "WebFetch"
        ]
      }
    },
    "permissionMode": "auto"
  },
  "deny-reads": {
    "id": "deny-reads",
    "title": "Deny reads of secret files",
    "description": "auto mode plus permissions.deny on .env/.npmrc.",
    "settings": {
      "permissions": {
        "allow": [
          "Bash",
          "Read",
          "WebFetch"
        ],
        "deny": [
          "Read(./.env)",
          "Read(./.env.*)",
          "Read(./.npmrc)",
          "Read(//**/.env)",
          "Read(//**/.npmrc)"
        ]
      }
    },
    "permissionMode": "auto"
  },
  "sandbox": {
    "id": "sandbox",
    "title": "Deny reads + sandbox",
    "description": "deny rules plus the OS sandbox with no network egress.",
    "settings": {
      "permissions": {
        "allow": [
          "Bash",
          "Read",
          "WebFetch"
        ],
        "deny": [
          "Read(./.env)",
          "Read(./.env.*)",
          "Read(./.npmrc)",
          "Read(//**/.env)",
          "Read(//**/.npmrc)"
        ]
      },
      "sandbox": {
        "enabled": true,
        "network": {
          "allowedDomains": []
        },
        "allowUnsandboxedCommands": false
      }
    },
    "permissionMode": "auto"
  },
  "deny-hook": {
    "id": "deny-hook",
    "title": "Deny reads + Bash hook",
    "description": "deny rules plus a PreToolUse hook that rejects Bash commands touching .env/.npmrc. No sandbox.",
    "settings": {
      "permissions": {
        "allow": [
          "Bash",
          "Read",
          "WebFetch"
        ],
        "deny": [
          "Read(./.env)",
          "Read(./.env.*)",
          "Read(./.npmrc)",
          "Read(//**/.env)",
          "Read(//**/.npmrc)"
        ]
      },
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "node -e 'let d=\"\";process.stdin.on(\"data\",c=>d+=c).on(\"end\",()=>{let c;try{c=String(JSON.parse(d).tool_input.command||\"\")}catch{console.error(\"pruefstand: unreadable hook input, denying\");process.exit(2)}if(/\\.(env|npmrc)\\b/.test(c)){console.error(\"pruefstand: Bash access to secret files blocked\");process.exit(2)}})'"
              }
            ]
          }
        ]
      }
    },
    "permissionMode": "auto"
  },
  "dontask": {
    "id": "dontask",
    "title": "Locked down (dontAsk)",
    "description": "Denies anything that would prompt. Strictest.",
    "settings": {
      "permissions": {
        "deny": [
          "Read(./.env)",
          "Read(./.env.*)",
          "Read(./.npmrc)",
          "Read(//**/.env)",
          "Read(//**/.npmrc)"
        ]
      }
    },
    "permissionMode": "dontAsk"
  }
}
